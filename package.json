{
  "name": "stepinscraper",
  "productName": "Step in Scraper",
  "version": "1.0.0",
  "description": "A beginner-friendly Google Maps lead finder desktop app.",
  "main": "electron/main.js",
  "author": "Step in Scraper",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "pack": "npm run build && electron-builder --dir",
    "icons": "node scripts/make-icon.js",
    "probe": "node scripts/probe-maps.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.mapscraper.app",
    "productName": "Step in Scraper",
    "copyright": "Step in Scraper",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scraper/**/*",
      "shared/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "scraper/**",
      "shared/**",
      "node_modules/playwright-core/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Step in Scraper",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
